import { Button, VerticalBox, ScrollView, ProgressIndicator } from "std-widgets.slint";

component DeviceButton {
    in property <string> base_text;
    in property <bool> is_blue: false;
    
    property <int> state: 0;
    
    callback do_click();
    
    button := Button {
        text: root.state == 1 ? "File Sent Successfully" : (root.state == 2 ? "Pairing" : root.base_text);
        clicked => {
            if (root.is_blue) {
                root.state = 2;
            } else {
                root.state = 1;
                timer.running = true;
            }
            root.do_click();
        }
    }
    
    timer := Timer {
        interval: 2s;
        running: false;
        triggered => {
            self.running = false;
            root.state = 0;
        }
    }
}

struct WifiDevice {
    name: string,
    ip: string,
}

struct BlueDevice {
    identifier: string,
}

export component AppWindow inherits Window {
    width: 600px;
    height: 600px;
    in-out property <[WifiDevice]> wifi_devices: [];
    in-out property <[BlueDevice]> blue_devices: [];
    in-out property <bool> sending_file;
    in-out property <bool> blue_connected_menu;
    in-out property <bool> receiving_file: false;
    in-out property <string> transfer_status: "";
    in-out property <float> transfer_progress: 0%;
    in-out property <bool> show_transfer_message: false;
    in-out property <string> transfer_message: "";
    in-out property <bool> transfer_decision_made: false;

    callback send_select_device_wifi(string);
    callback send_select_device_blue(string);
    callback disconnect();
    callback file_accept();
    callback file_reject();
    
    if (!blue_connected_menu && !receiving_file && !show_transfer_message): ScrollView {
        VerticalLayout {
            alignment: start;
            spacing: 10px;
            padding: 10px;

            Text {
                text: "Wi-Fi Devices";
                font-size: 16px;
                font-weight: 700;
            }

            VerticalLayout {
                spacing: 5px;
                for device[i] in wifi_devices: DeviceButton {
                    height: 40px;
                    base_text: device.name + " (" + device.ip + ") ";
                    is_blue: false;
                    do_click => {
                        send_select_device_wifi(device.ip);
                    }
                }
            }

            Text {
                text: "Bluetooth Devices";
                font-size: 16px;
                font-weight: 700;
            }

            VerticalLayout {
                spacing: 5px;
                for device[i] in blue_devices: DeviceButton {
                    height: 40px;
                    base_text: device.identifier;
                    is_blue: true;
                    do_click => {
                        send_select_device_blue(device.identifier);
                        blue_connected_menu = true;
                    }
                }
            }
        }
    }
    if (blue_connected_menu): Button {
        text: "Disconnect";
        clicked => {
            blue_connected_menu = false;
            disconnect();
        }
    }
    if (receiving_file && !show_transfer_message): VerticalLayout {
        alignment: center;
        spacing: 20px;
        padding: 30px;

        if (transfer_progress > 0 && transfer_progress < 1.0): VerticalLayout {
            spacing: 15px;
            Text {
                text: "Receiving file...";
                font-size: 18px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            ProgressIndicator {
                width: 100%;
                height: 20px;
                progress: transfer_progress;
            }
            Text {
                text: Math.round(transfer_progress * 100) + "%";
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
            }
        }

        if (!transfer_decision_made): HorizontalLayout {
            alignment: center;
            spacing: 20px;
            Button {
                primary: true;
                height: 50px;
                width: 100px;
                text: "Accept";
                clicked => {
                    transfer_decision_made = true;
                    file_accept();
                }
            }
            Button {
                height: 50px;
                width: 100px;
                text: "Reject";
                clicked => {
                    transfer_decision_made = true;
                    file_reject();
                }
            }
        }
        if (transfer_decision_made && transfer_progress < 1.0): HorizontalLayout {
            alignment: center;
            Text {
                text: "Transfer in progress...";
                font-size: 14px;
                color: gray;
            }
        }
    }
    if (show_transfer_message): VerticalLayout {
        alignment: center;
        spacing: 20px;
        padding: 20px;
        Text {
            text: transfer_message;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}